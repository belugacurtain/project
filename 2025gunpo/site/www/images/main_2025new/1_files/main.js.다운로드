        $shortcutList.slick(shortcutMainSlickOption);




        //바로가기 세팅
        $shortcutButton.on('click', function(event) {

            var $this = $(this),
                offsetTop = $this.offset().top,
                headerHeight = $header.height(),
                state = $.screen.settings.state;

            if(~$.inArray('tablet', state) || ~$.inArray('phone', state)) {
                $shortcutPanel.css('top', offsetTop - headerHeight);
            }

            $html.addClass('shortcut_open');
            //$shortcutList.slick('unslick');
            $shortcutForm.slick(shortcutPanelSlickOption).slick('setPosition');
        });

        $window.on('screen', function(event) {
            $shortcutList.slick('setPosition');
            $shortcutList.slick('setPosition');
        });

