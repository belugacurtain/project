                ItemLength = $SlideItem.length,
                $SlideControl = $boardSlide.siblings('.visual_control'),
                $SlidePage = $(this).find('.visual_count'),
                $Total = $SlidePage.find('.visual_total');
            $Total.text(ItemLength);
            $boardSlide.slick({
                autoplay : true,
                dots:false,
                slidesToShow: 1,
                slidesToScroll: 1,
                prevArrow : $SlideControl.find('.visual_prev'),
                nextArrow : $SlideControl.find('.visual_next'),
                pauseOnDotsHover : true,
                swipe:false,
                draggable:false,
                //추가 기능
                autoArrow : $SlideControl.find('.visual_auto'),
