                $OtherParents.removeClass('active');
                $OtherBtns.removeAttr('title');
                $MyParent.addClass('active');
                $this.attr('title', '선택됨');
                $OtherCon.removeClass('active');
                $MyCon.addClass('active');
                $MySlide.slick('setPosition');
            };
