        $socialButton.on('click', function() {
            var $this = $(this),
                socialIndex = $this.parent().index(),
                data = $this.data();

            $socialButton.removeClass('active');
            $this.addClass('active');

            $socialButton.removeAttr('title');
            $this.attr('title', '선택됨');

            $socialBlank.eq(socialIndex).addClass('active').siblings().removeClass('active');

