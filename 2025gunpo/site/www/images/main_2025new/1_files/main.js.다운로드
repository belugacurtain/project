        $popupzoneList.find('.slick-slide').removeAttr('tabindex');
        $popupzoneList.find('.popupzone_anchor').attr('tabindex','0');

        $popupzoneList.on("afterChange", function () {
            $popupzoneList.find('.popupzone_anchor').attr('tabindex','0');
            setTimeout(
