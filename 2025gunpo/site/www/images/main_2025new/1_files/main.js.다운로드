        /* 슬기로운 군포생활 */
        var $service = $container.find('.service'),
            $serviceOpen = $service.find('.service_open'),
            $serviceHide = $service.find('.service_hide');

        $serviceOpen.on('click', function(event) {
            $html.addClass('service_open');
            //$html.addClass('dimded').removeClass('lnb_show lnb_open');
        });
        $serviceHide.on('click', function(event) {
            $html.removeClass('service_open');
            //$html.removeClass('dimded');
        });


        /* 실생활 분야별 정보 */
